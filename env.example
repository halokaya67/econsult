# Copy to .env to change the fake backend's seeds; every value here is the app's built-in default.

# Fixture practice served by the fake backend: prc-0421, prc-0873, prc-0000 (else prc-0421).
EXPO_PUBLIC_PRACTICE_ID=prc-0421

# Non-negative ms delay for every fake request; empty = defaults (config 2000, others 1000).
EXPO_PUBLIC_LATENCY_MS=

# Comma-separated config|careTeam|create|upload:network|server|timeout pairs; empty = no faults.
EXPO_PUBLIC_FAULTS=
